# Template rendered by install.sh and update.sh — @PLACEHOLDERS@ are substituted
# there. Edit this file, not the generated unit in /etc/systemd/system.
[Unit]
Description=DynaDash FastAPI Backend
After=network.target influxdb.service
Wants=influxdb.service

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@BACKEND_DIR@
# The code tree is read-only for this user, so bytecode cannot be cached
# anyway; saying so avoids Python retrying the write on every import.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@BACKEND_DIR@/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dynadash-backend

# --- Sandboxing -------------------------------------------------------------
# The whole filesystem is read-only apart from the data directory, the service
# holds no capabilities, and it cannot gain any. Privileged update steps go
# through dynadash-update.path instead of anything setuid, which is what makes
# NoNewPrivileges possible here.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@BACKEND_DIR@/data
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
